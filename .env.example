# Chave da API Groq (gratuita, sem cartão)
# 1. Acesse: https://console.groq.com/keys
# 2. Crie uma conta e gere uma chave gratuita
# 3. Cole sua chave abaixo
VITE_GROQ_API_KEY=grok_chave

#coloca link do nosso servidor giros
#rotinas que usam ouvidoriapage, DenunciaPage
VITE_API_URL=url_site_servidor_giros

# Endpoints de envio
VITE_DENUNCIA_URL=url_endpoint_denuncia
VITE_OUVIDORIA_URL=url_endpoint_ouvidoria